# ============================================================
# 智能简历筛选系统 —— git 忽略清单
#
# 规则：不该进版本历史的东西在这里声明，分三类
#   1. 机器生成的产物  —— 随时可重建，提交了只制造噪音
#   2. 含密钥的文件    —— 提交就永久留在历史里，删文件也删不掉
#   3. 运行时数据      —— 数据属于运行时，不属于代码
#
# 注意：.gitignore 不支持"行尾注释"。下面每个 # 注释都必须独占一行，
#       写成 "*.pyc  # 编译产物" 会被当成一个带空格和井号的模式，静默失效。
# ============================================================

# ---------- Python 运行时产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---------- 虚拟环境 ----------
# 环境本身不进库：换台机器用 requirements.txt 重建即可
.venv/
venv/
env/
ENV/

# ---------- 密钥与本地配置（最重要的一段）----------
# 参考项目的 .env 里有真实 DeepSeek API key。
# 一旦被提交，密钥会永久留在 git 历史里 —— 之后删掉 .env 文件也没用，
# 必须重写全部历史才能清除。所以 .env 永远不进库；
# 需要给别人看的样例，只提交不含真实值的 .env.example。
.env
.env.*
!.env.example

# ---------- 测试与工具缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 本项目运行时会产生的数据（阶段 2 起出现）----------
# SQLite 真源、向量索引、简历文本缓存 —— 都是可重建的运行时产物。
*.db
*.sqlite
*.sqlite3
chroma_db/
cache/
uploads/
logs/
*.log
# data/ 暂不忽略：将来若放"示例简历语料"是要入库的，到阶段 6 再按需收窄。
# 现阶段先不忽略，避免误把要提交的样例数据挡在门外。

# ---------- 编辑器与操作系统 ----------
.idea/
.DS_Store
Thumbs.db
*.bak

# ---------- 与本项目无关的本地文件 ----------
# 这两个跟"简历筛选"没关系：一个是 VSCode 的个人环境设置，
# 一个是搬 Claude 配置的辅助脚本。保留在磁盘上，只是不算作项目文件。
.vscode/
scripts/
